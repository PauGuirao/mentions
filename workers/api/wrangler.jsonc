{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mentions-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Branded origin for API-key/MCP clients. The dashboard does NOT use it:
  // it proxies /v1/* through app.mentio.dev so session cookies stay
  // same-origin (which is why BETTER_AUTH_URL points there, not here).
  "routes": [{ "pattern": "api.mentio.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mentions",
      // Replace with the real id at provision time; local dev ignores it.
      "database_id": "d7544f01-aeb7-4d49-903e-821cf0244f64",
      // D1 schema lives in core next to the ops that query it.
      "migrations_dir": "../../packages/core/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "563524d26a444c0ca62c88b9616065c6"
    }
  ],
  // Website analysis at onboarding. Workers AI runs remotely even in local dev.
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AXIOM_DATASET": "mentio",
    // Public origin auth redirects resolve against; secrets
    // (BETTER_AUTH_SECRET, BETTER_AUTH_API_KEY, GOOGLE_CLIENT_ID/SECRET)
    // go via `wrangler secret put`, never here.
    // The dashboard proxies /v1/* through its own origin (service binding),
    // so the browser-facing auth origin is app.mentio.dev, not the api's
    // workers.dev host.
    "BETTER_AUTH_URL": "https://app.mentio.dev",
    "TRUSTED_ORIGINS": "http://localhost:5173,https://app.mentio.dev,https://mentio.dev,https://mentions-web.guiraocastells.workers.dev"
  }
}
