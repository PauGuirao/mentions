{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mentions-landing",
  "compatibility_date": "2026-06-01",
  "routes": [
    { "pattern": "mentio.dev", "custom_domain": true },
    { "pattern": "www.mentio.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist"
  }
}
