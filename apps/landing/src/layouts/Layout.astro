---
import '../styles/global.css';
import { APP_URL, DOCS_URL } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mentio: social listening for dev platforms',
  description = 'Track keyword and brand mentions across Bluesky, Hacker News, Reddit, X, GitHub and more. AI-scored, delivered anywhere, priced by usage. API and MCP first.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-white font-sans text-zinc-900 antialiased">
    <div class="mx-auto min-h-screen max-w-6xl border-x border-zinc-200 bg-white">
      <header class="sticky top-0 z-40 border-b border-zinc-200 bg-white/90 backdrop-blur">
        <nav class="flex h-14 items-center gap-6 px-6">
          <a href="/" class="flex items-center gap-2">
            <span
              class="flex size-6 items-center justify-center rounded-md bg-zinc-900 font-mono text-sm font-bold text-zinc-50"
              >@</span
            >
            <span class="font-semibold tracking-tight">Mentio</span>
          </a>
          <div class="ml-auto flex items-center gap-1 text-sm">
            <a
              href="#how-it-works"
              class="rounded-md px-3 py-1.5 text-zinc-600 hover:text-zinc-900">How it works</a
            >
            <a href="#pricing" class="rounded-md px-3 py-1.5 text-zinc-600 hover:text-zinc-900"
              >Pricing</a
            >
            <a href={DOCS_URL} class="rounded-md px-3 py-1.5 text-zinc-600 hover:text-zinc-900"
              >Docs</a
            >
            <a
              href={APP_URL}
              class="ml-2 rounded-full bg-zinc-900 px-4 py-1.5 font-medium text-zinc-50 hover:bg-zinc-700"
              >Dashboard</a
            >
          </div>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <div
          class="flex flex-col items-start justify-between gap-6 px-6 py-10 sm:flex-row sm:items-center"
        >
          <div class="flex items-center gap-2">
            <span
              class="flex size-6 items-center justify-center rounded-md bg-zinc-900 font-mono text-sm font-bold text-zinc-50"
              >@</span
            >
            <span class="font-semibold tracking-tight">Mentio</span>
            <span class="ml-2 text-sm text-zinc-500">Social listening for dev platforms.</span>
          </div>
          <div class="flex flex-wrap gap-5 text-sm text-zinc-600">
            <a href="/#pricing" class="hover:text-zinc-900">Pricing</a>
            <a href={DOCS_URL} class="hover:text-zinc-900">Docs</a>
            <a href={`${DOCS_URL}/api/keywords/create-keyword`} class="hover:text-zinc-900"
              >API reference</a
            >
            <a href={`${DOCS_URL}/mcp`} class="hover:text-zinc-900">MCP</a>
            <a href="/privacy" class="hover:text-zinc-900">Privacy</a>
            <a href="/terms" class="hover:text-zinc-900">Terms</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
