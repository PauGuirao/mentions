---
const steps = [
  {
    n: '01',
    title: 'Track keywords',
    body: 'Your brand, your competitors, your space. One POST per term, or a click in the dashboard.',
  },
  {
    n: '02',
    title: 'The pipeline watches everything',
    body: 'Every source is ingested once, matched against your terms, and classified by AI: relevance 0 to 100, sentiment, and intent, tuned by your company context.',
  },
  {
    n: '03',
    title: 'Act on what matters',
    body: 'Triage in the dashboard, deliver to Slack or webhooks, query the REST API, or let your AI agent work the feed over MCP.',
  },
];
---

<section id="how-it-works" class="border-b border-zinc-200">
  <div class="px-6 pt-20 pb-12 text-center">
    <p class="font-mono text-xs tracking-[0.25em] text-zinc-400 uppercase">
      [ 01 / 04 ] &middot; How it works
    </p>
    <h2 class="mx-auto mt-4 max-w-xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      From post to signal <span class="text-zinc-400">in three steps</span>
    </h2>
  </div>
  <div class="grid gap-px border-t border-zinc-200 bg-zinc-200 md:grid-cols-3">
    {
      steps.map((step) => (
        <div class="bg-white p-8">
          <p class="font-mono text-sm text-zinc-400">{step.n}</p>
          <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">{step.body}</p>
        </div>
      ))
    }
  </div>
</section>
