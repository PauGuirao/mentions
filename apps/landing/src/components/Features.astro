---
/** Icon paths are lucide-style 24x24 strokes, inlined to avoid a dependency. */
const features = [
  {
    icon: 'M13 2 3 14h9l-1 8 10-12h-9l1-8z',
    title: 'Real time to minutes',
    body: 'Bluesky lands in seconds via the firehose. Hacker News in about a minute. Every conversational source in minutes, not hours.',
  },
  {
    icon: 'M12 3l1.9 5.6 5.6 1.9-5.6 1.9L12 18l-1.9-5.6L4.5 10.5l5.6-1.9L12 3z',
    title: 'AI that reads every post',
    body: 'Relevance scoring, sentiment, and intent detection (buy intent, question, complaint, praise, comparison) on each mention, guided by your company context.',
  },
  {
    icon: 'm16 18 6-6-6-6M8 6l-6 6 6 6',
    title: 'API-first',
    body: 'A clean REST API with an OpenAPI spec, keyset pagination, and stable error codes. The dashboard is just another client.',
  },
  {
    icon: 'm4 17 6-5-6-5M12 19h8',
    title: 'MCP built in',
    body: 'A Model Context Protocol server with eight tools, so Claude, Cursor, or any agent can search, triage, and manage tracking for you.',
  },
  {
    icon: 'm22 2-7 20-4-9-9-4 20-7zM22 2 11 13',
    title: 'Deliver anywhere',
    body: 'Slack and webhook destinations with filtered feeds: only the sources, sentiments, and relevance levels you care about.',
  },
  {
    icon: 'M3 17l6-6 4 4 8-8M21 7v5h-5',
    title: 'Priced by usage',
    body: 'Pay per keyword, each with relevant mentions included in a shared pool. Noise the classifier filters out is always free. No seats, no tiers.',
  },
];
---

<section class="border-b border-zinc-200">
  <div class="px-6 pt-20 pb-12 text-center">
    <p class="font-mono text-xs tracking-[0.25em] text-zinc-400 uppercase">
      [ 02 / 04 ] &middot; Features
    </p>
    <h2 class="mx-auto mt-4 max-w-xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      Built like a dev tool, <span class="text-zinc-400">because it is one</span>
    </h2>
  </div>
  <div class="grid gap-px border-t border-zinc-200 bg-zinc-200 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature) => (
        <div class="bg-white p-8">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-5 text-zinc-400"
            aria-hidden="true"
          >
            <path d={feature.icon} />
          </svg>
          <h3 class="mt-4 font-semibold">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">{feature.body}</p>
        </div>
      ))
    }
  </div>
</section>
