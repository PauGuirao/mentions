---
import {
  FREE_KEYWORDS,
  FREE_MENTIONS_MONTHLY,
  MENTION_UNIT,
  PRICE_PER_KEYWORD,
  PRICE_PER_MENTION,
  PRICE_PER_MENTION_UNIT,
  TRIAL_DAYS,
  TRIAL_MENTIONS,
} from '../config';
import { APP_URL, SELF_SERVE_KEYWORDS } from '../config';

interface Props {
  /** Overridden on the standalone /pricing page (no section numbering). */
  eyebrow?: string;
}
const { eyebrow = '[ 03 / 04 ] &middot; Pricing' } = Astro.props;
---

<section id="pricing" class="border-b border-zinc-200">
  <div class="px-6 pt-20 pb-12 text-center">
    <p class="font-mono text-xs tracking-[0.25em] text-zinc-400 uppercase" set:html={eyebrow} />
    <h2 class="mx-auto mt-4 max-w-xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      Pay for what you track, <span class="text-zinc-400">and what we find</span>
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-zinc-600">
      No seats. No tiers. One price per mention we find for you.
    </p>
  </div>

  <div class="border-t border-zinc-200">
    <div class="grid gap-px bg-zinc-200 sm:grid-cols-2">
      <div class="bg-white p-10 text-center">
        <p class="font-mono text-5xl font-semibold tracking-tight">
          &euro;{PRICE_PER_KEYWORD}<span class="text-base font-normal text-zinc-500">/mo</span>
        </p>
        <p class="mt-2 text-sm text-zinc-500">per keyword tracked</p>
      </div>
      <div class="bg-white p-10 text-center">
        <p class="font-mono text-5xl font-semibold tracking-tight">
          &euro;{PRICE_PER_MENTION_UNIT}
        </p>
        <p class="mt-2 text-sm text-zinc-500">
          per {MENTION_UNIT.toLocaleString('en-US')} mentions
        </p>
      </div>
    </div>

    <div class="border-t border-zinc-200 bg-zinc-50 px-6 py-12 sm:px-12">
      <div class="mx-auto grid max-w-4xl gap-10 lg:grid-cols-[1fr_20rem]">
        <div>
          <p class="font-mono text-xs tracking-[0.25em] text-zinc-400 uppercase">
            Estimate your bill
          </p>
          <label class="mt-8 block">
            <span class="flex items-baseline justify-between text-sm">
              <span class="text-zinc-600">Keywords tracked</span>
              <span class="font-mono text-lg" id="kw-value">5</span>
            </span>
            <input id="kw" type="range" min="0" max="100" value="26" class="calc-range mt-4 w-full" />
          </label>
          <label class="mt-8 block">
            <span class="flex items-baseline justify-between text-sm">
              <span class="text-zinc-600">Mentions per month</span>
              <span class="font-mono text-lg" id="m-value">1,500</span>
            </span>
            <input id="m" type="range" min="0" max="100" value="12" class="calc-range mt-4 w-full" />
          </label>
          <p class="mt-8 text-sm text-zinc-500">
            Your first {FREE_MENTIONS_MONTHLY} mentions each month are free. Past them,
            every mention bills &euro;{PRICE_PER_MENTION} (&euro;{PRICE_PER_MENTION_UNIT} per {
              MENTION_UNIT.toLocaleString('en-US')
            }). Every mention we find for your keywords counts.
          </p>
        </div>

        <div class="border border-zinc-200 bg-white">
          <div class="grid gap-3 p-6 text-sm">
            <p class="flex items-baseline justify-between gap-4">
              <span class="text-zinc-600" id="line-kw">5 keywords &times; &euro;5</span>
              <span class="font-medium tabular-nums" id="cost-kw">&euro;25</span>
            </p>
            <p class="flex items-baseline justify-between gap-4">
              <span class="text-zinc-600" id="line-incl">First 100 mentions each month</span>
              <span class="text-zinc-400">Free</span>
            </p>
            <p class="hidden items-baseline justify-between gap-4" id="row-over">
              <span class="text-zinc-600" id="line-over">Extra mentions &middot; 0 &times; 1,000</span>
              <span class="font-medium tabular-nums" id="cost-over">&euro;0</span>
            </p>
            <div class="border-t border-zinc-200 pt-3">
              <p class="flex items-baseline justify-between gap-4">
                <span class="text-zinc-600">Monthly total</span>
                <span class="font-mono text-2xl font-semibold tabular-nums" id="total">&euro;25</span>
              </p>
            </div>
          </div>
          <div class="border-t border-zinc-200 p-6">
            <a
              href={`${APP_URL}/login?mode=signup`}
              class="block bg-zinc-900 px-6 py-3 text-center font-medium text-white hover:bg-zinc-700"
            >
              Start {TRIAL_DAYS} day free trial
            </a>
            <p class="mt-3 text-center text-xs text-zinc-500">
              {FREE_KEYWORDS} keywords, {TRIAL_MENTIONS} mentions, {TRIAL_DAYS} days.
              No card needed.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="border-t border-zinc-200">
      <div class="grid gap-px bg-zinc-200 sm:grid-cols-2">
        <div class="bg-white p-10">
          <p class="font-mono text-xs tracking-[0.25em] text-zinc-400 uppercase">Self serve</p>
          <p class="mt-3 text-xl font-semibold tracking-tight">
            Up to {SELF_SERVE_KEYWORDS} keywords
          </p>
          <ul class="mt-4 grid gap-2 text-sm text-zinc-600">
            <li>Public rate card, billed monthly to your card</li>
            <li>{TRIAL_DAYS} day free trial, cancel anytime</li>
            <li>Every feature included: Slack, API, MCP</li>
            <li>Chat and email support</li>
          </ul>
          <a
            href={`${APP_URL}/login?mode=signup`}
            class="mt-6 inline-block bg-zinc-900 px-6 py-2.5 font-medium text-white hover:bg-zinc-700"
          >
            Start free
          </a>
        </div>
        <div class="bg-white p-10">
          <p class="font-mono text-xs tracking-[0.25em] text-zinc-400 uppercase">Enterprise</p>
          <p class="mt-3 text-xl font-semibold tracking-tight">
            More than {SELF_SERVE_KEYWORDS} keywords
          </p>
          <ul class="mt-4 grid gap-2 text-sm text-zinc-600">
            <li>Same rate card with volume discounts</li>
            <li>Postpaid invoicing</li>
            <li>Custom polling cadences and sources</li>
            <li>Dedicated support channel</li>
          </ul>
          <a
            href="/enterprise"
            class="mt-6 inline-block border border-zinc-300 px-6 py-2.5 font-medium text-zinc-900 hover:bg-zinc-50"
          >
            Talk to us
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Custom range styling: hairline track with a filled left segment (painted
     from JS as a gradient) and a square thumb, matching the sharp-corner
     aesthetic. */
  .calc-range {
    appearance: none;
    -webkit-appearance: none;
    height: 2px;
    background: #e4e4e7;
    outline: none;
    cursor: pointer;
  }
  .calc-range::-webkit-slider-thumb {
    appearance: none;
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    background: #18181b;
    border: none;
    border-radius: 0;
  }
  .calc-range::-moz-range-thumb {
    width: 14px;
    height: 14px;
    background: #18181b;
    border: none;
    border-radius: 0;
  }
  .calc-range:focus-visible {
    box-shadow:
      0 0 0 3px #fafafa,
      0 0 0 5px #a1a1aa;
  }
</style>

<script>
  import {
    FREE_MENTIONS_MONTHLY,
    PRICE_PER_KEYWORD,
    PRICE_PER_MENTION,
  } from '../config';

  const kw = document.getElementById('kw') as HTMLInputElement;
  const m = document.getElementById('m') as HTMLInputElement;
  const kwValue = document.getElementById('kw-value')!;
  const mValue = document.getElementById('m-value')!;
  const lineKw = document.getElementById('line-kw')!;
  const costKw = document.getElementById('cost-kw')!;
  const lineIncl = document.getElementById('line-incl')!;
  const lineOver = document.getElementById('line-over')!;
  const costOver = document.getElementById('cost-over')!;
  const rowOver = document.getElementById('row-over')!;
  const total = document.getElementById('total')!;

  const fmt = (n: number) => n.toLocaleString('en-US');

  // Non-linear scales keep the low end precise while reaching the self-serve
  // ceiling: keywords 1..500 on a log curve, mentions 0..100k on a square
  // curve, snapped to clean steps.
  const KW_MAX = 500;
  const MENTIONS_MAX = 100_000;
  const keywordsFromRaw = (raw: number) => Math.round(KW_MAX ** (raw / 100));
  const mentionsFromRaw = (raw: number) => {
    const value = MENTIONS_MAX * (raw / 100) ** 2;
    const step = value < 5000 ? 100 : value < 20000 ? 500 : 1000;
    return Math.round(value / step) * step;
  };

  const paintTrack = (input: HTMLInputElement) => {
    const share = (Number(input.value) / 100) * 100;
    input.style.background = `linear-gradient(to right, #18181b ${share}%, #e4e4e7 ${share}%)`;
  };

  function update() {
    const keywords = Math.max(1, keywordsFromRaw(Number(kw.value)));
    const mentions = mentionsFromRaw(Number(m.value));
    kwValue.textContent = String(keywords);
    mValue.textContent = fmt(mentions);
    paintTrack(kw);
    paintTrack(m);

    const included = FREE_MENTIONS_MONTHLY;
    const overage = Math.max(0, mentions - included);
    const mentionCost = overage * PRICE_PER_MENTION;
    const bill = keywords * PRICE_PER_KEYWORD + mentionCost;
    const euro = (n: number) =>
      `€${n.toLocaleString('en-US', {
        minimumFractionDigits: Number.isInteger(n) ? 0 : 2,
        maximumFractionDigits: 2,
      })}`;

    lineKw.textContent = `${keywords} keyword${keywords === 1 ? '' : 's'} × €${PRICE_PER_KEYWORD}`;
    costKw.textContent = euro(keywords * PRICE_PER_KEYWORD);
    lineIncl.textContent = `First ${fmt(included)} mentions each month`;
    // The overage line only appears once it costs something; a €0 row reads
    // like a warning.
    rowOver.classList.toggle('hidden', overage === 0);
    rowOver.classList.toggle('flex', overage > 0);
    lineOver.textContent = `${fmt(overage)} extra mentions × €${PRICE_PER_MENTION}`;
    costOver.textContent = euro(mentionCost);
    total.textContent = euro(bill);
  }

  kw.addEventListener('input', update);
  m.addEventListener('input', update);
  update();
</script>
