{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mentions-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "routes": [{ "pattern": "app.mentio.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  "services": [
    {
      "binding": "API",
      "service": "mentions-api"
    }
  ]
}
